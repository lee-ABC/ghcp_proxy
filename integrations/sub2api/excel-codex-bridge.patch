+    finally:
+        excel_upstream.native_call_scope.reset(token)
+        excel_upstream._native_call_cache.clear()
+
+def test_upstream_auth_failure_does_not_try_global_session():
+    requests=[]
+    def upstream(request):
+        requests.append(request)
+        return httpx.Response(401,json={'error':{'message':'expired upstream session'}})
+    app=app_for(upstream);app.app.state.bridge.reader.store.configure(session_headers(account='global'),persist=False)
