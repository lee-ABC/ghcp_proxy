+import asyncio
+import json
+import time
+import httpx
+import pytest
+from helpers import session_headers
+from test_server import text_stream
+from excel_codex_bridge import sub2api, excel_upstream, pool_transport
+
+API = 'public-' + 'a' * 40
+ADMIN = 'admin-' + 'b' * 40
+TRANSPORT = 'transport-' + 'c' * 40
+
+def identity(account='account-a', scope='a' * 64, exp=None):
+    token = session_headers(exp=exp)['authorization'].split(' ', 1)[1]
+    return {'authorization': 'Bearer ' + TRANSPORT, 'x-sub2-excel-access-token': token,
+            'x-sub2-excel-account-id': account, 'x-sub2-excel-scope': scope}
+
+def app_for(handler):
+    return sub2api.create_app(sub2api.GatewayKeys(API, ADMIN), transport_key=TRANSPORT,
+        client_factory=lambda: httpx.AsyncClient(transport=httpx.MockTransport(handler)))
+
+def call(app, headers=None, **body):
+    async def run():
+        async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url='http://sidecar') as client:
+            return await client.post(sub2api.POOL_PATH, headers=headers or identity(), json=body or {'model': 'gpt-6-sol', 'input': 'hi'})
+    return asyncio.run(run())
+
+@pytest.mark.parametrize('key', [API, ADMIN, 'invalid', ''])
+def test_private_endpoint_rejects_other_keys(key):
+    def upstream(request):
+        pytest.fail('must not call upstream')
+    headers=identity();headers['authorization']='Bearer '+key
+    assert call(app_for(upstream),headers).status_code == 401
+
+@pytest.mark.parametrize('field,value', [('x-sub2-excel-access-token',''),('x-sub2-excel-account-id',''),('x-sub2-excel-scope','bad')])
+def test_invalid_identity_never_falls_back(field,value):
+    def upstream(request):
+        pytest.fail('must not call upstream')
+    app=app_for(upstream)
+    app.app.state.bridge.reader.store.configure(session_headers(account='global-session'), persist=False)
+    headers=identity();headers[field]=value
+    assert call(app,headers).status_code == 400
+
+def test_duplicate_identity_rejected():
+    headers=list(identity().items())+[('x-sub2-excel-account-id','another')]
+    assert call(app_for(lambda r: pytest.fail('no upstream')),headers).status_code == 400
+
+def test_expired_identity_rejected():
+    assert call(app_for(lambda r: pytest.fail('no upstream')),identity(exp=time.time()-60)).status_code == 400
+
+@pytest.mark.parametrize('model',['gpt-6-sol','gpt-6-astra','gpt-5.6-sol','gpt-5.6-terra','gpt-5.6-luna'])
+@pytest.mark.parametrize('stream',[False,True])
+def test_concurrent_identity_and_output_models(model,stream,monkeypatch):
+    requests=[];bridges=[]
+    original=pool_transport.RequestBridge.__init__
+    def track(self,*args):
+        original(self,*args);bridges.append(self)
+    monkeypatch.setattr(pool_transport.RequestBridge,'__init__',track)
+    async def upstream(request):
+        await asyncio.sleep(0.002)
+        requests.append((dict(request.headers),json.loads(request.content)))
+        return httpx.Response(200,headers={'content-type':'text/event-stream'},content=text_stream('OK'))
+    app=app_for(upstream)
+    async def run():
+        async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app),base_url='http://sidecar') as client:
+            return await asyncio.gather(*[client.post(sub2api.POOL_PATH,headers=identity('account-'+str(i),format(i,'064x')),
+                json={'model':model,'input':'hi','stream':stream,'prompt_cache_key':'same-session'}) for i in range(8)])
+    results=asyncio.run(run())
+    assert all(r.status_code==200 for r in results)
+    assert all(model in r.text for r in results)
+    assert {h['chatgpt-account-id'] for h,b in requests} == {'account-'+str(i) for i in range(8)}
+    assert len({b['prompt_cache_key'] for h,b in requests})==8
+    assert all(not any(k.startswith('x-sub2-excel') for k in h) for h,b in requests)
+    assert all(not b.reader.store.status()['configured'] for b in bridges)
+    assert not app.app.state.bridge.reader.store.status()['configured']
+
+def test_private_tool_replay_is_namespaced(monkeypatch,tmp_path):
+    monkeypatch.setattr(excel_upstream,'_native_call_store_path',None)
+    excel_upstream._native_call_cache.clear()
+    item={'call_id':'same-call','type':'function_call','name':'run_officejs','arguments':'account-a-private'}
+    token=excel_upstream.native_call_scope.set('group-a')
+    try:
+        excel_upstream._remember_native_call(item)
+        assert excel_upstream._remembered_native_call('same-call')==item
+        excel_upstream.native_call_scope.set('group-b')
+        assert excel_upstream._remembered_native_call('same-call') is None
+        excel_upstream.native_call_scope.set('')
