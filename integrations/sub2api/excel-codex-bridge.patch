diff --git a/src/excel_codex_bridge/pool_transport.py b/src/excel_codex_bridge/pool_transport.py
new file mode 100644
index 0000000..0d051f0
--- /dev/null
+++ b/src/excel_codex_bridge/pool_transport.py
@@ -0,0 +1,137 @@
+import hashlib
+import json
+import re
+import zlib
+from urllib.parse import urlsplit
+import httpx
+from fastapi import Request
+from starlette.responses import Response, StreamingResponse, JSONResponse
+from . import sse, excel_upstream
+from .server import Bridge, MAX_BODY_BYTES, build_upstream_client
+from .sub2api import BodyTooLarge, POOL_PATH, PushedSessionReader, read_json
+
+class RequestSessionReader(PushedSessionReader):
+    def fall_back(self, refused):
+        return False
+
+class ScopedResponse(Response):
+    def __init__(self, response, bridge):
+        self.response, self.bridge = response, bridge
+        self.status_code = response.status_code
+        self.raw_headers = response.raw_headers
+        self.background = None
+
+    async def __call__(self, scope, receive, send):
+        scope_token = excel_upstream.native_call_scope.set(self.bridge.replay_scope)
+        try:
+            await self.response(scope, receive, send)
+        finally:
+            try:
+                await self.bridge.aclose()
+            finally:
+                self.bridge.reader.store.clear()
+                excel_upstream.native_call_scope.reset(scope_token)
+
+class RequestBridge(Bridge):
+    def __init__(self, reader, factory, model, namespace):
+        super().__init__(reader, factory)
+        self.response_model = model
+        self.replay_scope = namespace
+
+    async def _stream(self, headers, upstream_body, source_body):
+        response = await super()._stream(headers, upstream_body, source_body)
+        if not isinstance(response, StreamingResponse):
+            return response
+        original = response.body_iterator
+        async def restore_model():
+            async for event, data in sse.iter_sse_messages(original):
+                if data is None:
+                    continue
+                try:
+                    payload = json.loads(data)
+                except (ValueError, TypeError):
+                    yield ('data: ' + data + chr(10) * 2).encode()
+                    continue
+                if isinstance(payload, dict):
+                    if isinstance(payload.get('response'), dict):
+                        payload['response']['model'] = self.response_model
+                    elif 'model' in payload:
+                        payload['model'] = self.response_model
+                if event:
+                    yield sse.sse_encode(event, payload)
+                else:
+                    yield ('data: ' + json.dumps(payload, ensure_ascii=False) + chr(10) * 2).encode()
+        response.body_iterator = restore_model()
+        return response
+
+    async def _non_stream(self, headers, upstream_body, source_body):
+        response = await super()._non_stream(headers, upstream_body, source_body)
+        if response.status_code < 400:
+            payload = json.loads(response.body)
+            payload['model'] = self.response_model
+            return JSONResponse(payload, status_code=response.status_code)
+        return response
+
+
+def identity_header(request, name, required=True):
+    values = request.headers.getlist(name)
+    if not values and not required:
+        return ''
+    if len(values) != 1 or not values[0] or len(values[0]) > 32768:
+        raise ValueError('Invalid identity')
+    if any(ord(c) < 33 or ord(c) > 126 for c in values[0]):
+        raise ValueError('Invalid identity')
+    return values[0]
+
+
+def attach_pool_route(app, client_factory=build_upstream_client):
+    @app.post(POOL_PATH)
+    async def pool_responses(request: Request):
+        reader = RequestSessionReader()
+        bridge = None
+        try:
+            token = identity_header(request, 'x-sub2-excel-access-token')
+            account = identity_header(request, 'x-sub2-excel-account-id')
+            namespace = identity_header(request, 'x-sub2-excel-scope')
+            if not re.fullmatch(r'[0-9a-f]{64}', namespace):
+                raise ValueError('Invalid scope')
+            headers = {'authorization': 'Bearer ' + token, 'chatgpt-account-id': account, 'x-openai-account-id': account}
+            user = identity_header(request, 'x-sub2-excel-account-user-id', False)
+            if user:
+                headers['x-openai-account-user-id'] = user
+            reader.store.configure(headers, persist=False, allow_expired=False)
+            proxy = identity_header(request, 'x-sub2-excel-proxy', False)
+            if proxy and (urlsplit(proxy).scheme not in {'http', 'https', 'socks5', 'socks5h'} or not urlsplit(proxy).hostname):
+                raise ValueError('Invalid proxy')
+            body = await read_json(request, MAX_BODY_BYTES)
+            if 'stream' in body and not isinstance(body['stream'], bool):
+                raise ValueError('Invalid stream flag')
+            hint = body.get('prompt_cache_key') or body.get('session_id')
+            if hint is None:
+                hint = json.dumps(body.get('input'), ensure_ascii=True, sort_keys=True)
+            body['prompt_cache_key'] = hashlib.sha256((namespace + ':' + str(hint)).encode()).hexdigest()
+            factory = client_factory
+            if proxy or client_factory is build_upstream_client:
+                factory = lambda: httpx.AsyncClient(proxy=proxy or None, trust_env=False, verify=True, timeout=httpx.Timeout(connect=30, read=600, write=60, pool=30))
+            bridge = RequestBridge(reader, factory, body.get('model'), namespace)
+            scope_token = excel_upstream.native_call_scope.set(namespace)
+            try:
+                response = await bridge.responses(body)
+            finally:
+                excel_upstream.native_call_scope.reset(scope_token)
+            return ScopedResponse(response, bridge)
+        except BodyTooLarge:
+            if bridge:
+                await bridge.aclose()
+            reader.store.clear()
+            return sse.openai_error_response(413, 'Request body is too large')
+        except (ValueError, zlib.error, RecursionError):
+            if bridge:
+                await bridge.aclose()
+            reader.store.clear()
+            return sse.openai_error_response(400, 'Invalid selected-account identity or request')
+        except BaseException:
+            if bridge:
+                await bridge.aclose()
+            reader.store.clear()
+            raise
