@@ -0,0 +1,48 @@
+import unittest
+from excel_codex_bridge import excel_upstream
+from test_server import BridgeHarness, ok_stream
+
+class Gpt6ExcelTests(unittest.TestCase):
+    def test_old_and_new_routes_remain_explicit(self):
+        expected = {
+            "gpt-5.6-luna-excel": "gpt-5.6-luna",
+            "gpt-5.6-terra-excel": "gpt-5.6-terra",
+            "gpt-5.6-sol-excel": "gpt-5.6-sol",
+            "gpt-6-astra-excel": "gpt-6-astra",
+            "gpt-6-excel": "gpt-6-sol",
+        }
+        self.assertEqual(excel_upstream.EXCEL_MODEL_UPSTREAMS, expected)
+        self.assertEqual(excel_upstream.MODEL_ID, "gpt-5.6-sol-excel")
+        for alias, upstream in expected.items():
+            with self.subTest(alias=alias):
+                body = excel_upstream.prepare_responses_body({"model": alias, "input": "ping"})
+                self.assertEqual(body["model"], upstream)
+                self.assertEqual(body["model_selection"], "explicit")
+                self.assertFalse(body["store"])
+
+    def test_stream_and_non_stream(self):
+        for stream in (False, True):
+            with self.subTest(stream=stream):
+                harness = BridgeHarness(ok_stream)
+                response = harness.request("POST", "/v1/responses", json={
+                    "model": "gpt-6-excel", "input": "ping", "stream": stream})
+                self.assertEqual(response.status_code, 200)
+                self.assertEqual(harness.upstream_json()["model"], "gpt-6-sol")
+                self.assertEqual(harness.upstream_json()["stream"], stream)
+                if not stream:
+                    self.assertEqual(response.json()["model"], "gpt-6-excel")
+
+    def test_catalog_keeps_old_models_and_appends_new(self):
+        response = BridgeHarness(ok_stream).request("GET", "/v1/models")
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual([x["id"] for x in response.json()["data"]], [
+            "gpt-5.6-luna-excel", "gpt-5.6-terra-excel",
+            "gpt-5.6-sol-excel", "gpt-6-astra-excel", "gpt-6-excel"])
+
+    def test_unknown_model_still_rejected(self):
+        harness = BridgeHarness(ok_stream)
+        response = harness.request("POST", "/v1/responses", json={
+            "model": "gpt-not-a-real-excel-model", "input": "ping"})
+        self.assertEqual(response.status_code, 400)
+        self.assertEqual(response.json()["error"]["code"], "model_not_found")
+        self.assertEqual(harness.upstream_requests, [])
